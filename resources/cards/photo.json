{
  "name": "photo",
  "use_when": "The document has a main picture: it fills the card under a dark overlay, with the words over it. The words take the overlay's light text (never the accent's text colour, which is dark on a light accent and unreadable on the overlay).",
  "nodes": [
    {
      "primitive": "box",
      "props": { "direction": "column", "gap": "sm" },
      "style": {
        "width": "full",
        "background": "image",
        "background_image_url": "{{picture}}",
        "background_overlay": "dark",
        "padding": "spacious",
        "padding_x": "spacious",
        "min_height": "lg",
        "justify": "end"
      },
      "children": [
        { "primitive": "text", "props": { "value": "{{kicker}}" }, "style": { "font_weight": "semibold" }, "card": { "requires": "kicker", "max": 60 } },
        { "primitive": "heading", "props": { "text": "{{title}}", "level": 1 }, "style": { "heading_size": "lg", "line_height": "tight" }, "card": { "max": 80 } },
        { "primitive": "text", "props": { "value": "{{subtitle}}" }, "style": { "body_size": "lg" }, "card": { "requires": "subtitle", "max": 120 } },
        { "primitive": "credentials", "props": { "heading": "" }, "card": { "when": "pin_identity" } }
      ]
    }
  ]
}
